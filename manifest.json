{
  "manifest_version": 3,
  "name": "Teapot",
  "version": "1.2.0",
  "description": "Steep the current page: open its latest archive.today snapshot in reader mode. 418 if there is none.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vibrating-teapot@w0de.github.io",
      "strict_min_version": "115.0",
      "update_url": "https://github.com/w0de/vibrating-teapot/releases/latest/download/updates.json"
    }
  },
  "permissions": ["tabs", "storage", "scripting", "menus"],
  "host_permissions": [
    "*://archive.li/*",
    "*://archive.md/*",
    "*://archive.ph/*",
    "*://archive.today/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Steep this page  ·  archive + reader",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
